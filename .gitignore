# PyCharm
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Abstra
# Abstra is an AI-powered process automation framework.
# Ignore directories containing user credentials, local state, and settings.
# Learn more at https://abstra.io/docs
.abstra/

# Visual Studio Code
#  Visual Studio Code specific template is maintained in a separate VisualStudioCode.gitignore 
#  that can be found at https://github.com/github/gitignore/blob/main/Global/VisualStudioCode.gitignore
#  and can be added to the global gitignore or merged into this file. However, if you prefer, 
#  you could uncomment the following to ignore the entire vscode folder
# .vscode/

# Ruff stuff:
.ruff_cache/

# PyPI configuration file
.pypirc

# Cursor
#  Cursor is an AI-powered code editor. `.cursorignore` specifies files/directories to
#  exclude from AI features like autocomplete and code analysis. Recommended for sensitive data
#  refer to https://docs.cursor.com/context/ignore-files
.cursorignore
.cursorindexingignore

# Marimo
marimo/_static/
marimo/_lsp/
__marimo__/

# Environment variables (keep .env.example)
.env.local

# OAuth tokens (sensitive)
systems/outlook-tokens.json

# System docs (contain credentials/config)
systems/zoho-mail.md
systems/outlook.md

# Agent config — contains private data (roles, personality, memory, credentials)
# Copy config/ between machines; don't check it in.
# See config.example/ for the expected structure (including per-agent
# `agent.yaml` templates).
config/*
# Exception: capability framework definitions are tracked.
!config/providers.yaml
!config/baseline.yaml
# D-5: quota thresholds are operator config, tracked like providers.yaml.
!config/dispatch.yaml
# agents.yaml — structured identity model (issue #124). Contains only secret
# *references* (${SECRET:VAR_NAME}), not actual secrets — safe to track.
!config/agents.yaml
# JSON schema for agents.yaml — documentation, no sensitive data.
!config/agents.schema.json
!config/agents/
config/agents/*
!config/agents/*/
config/agents/*/*
# Note: `config/agents/*/agent.yaml` is intentionally NOT un-ignored.
# It's mutated at runtime by `grant`/`revoke` (router/packs/grants.py)
# and is part of each host's private state. Tracking it caused the
# deploy daemon's `git reset --hard origin/main` to clobber live edits
# and granted packs every cycle.
# Exception: secrets example files (templates, not real credentials)
!config/secrets/
config/secrets/*
!config/secrets/*.example.json

# Pack runtime data — single secret store keyed by pack name
/data/

# Local Claude Code scheduled-task lock (runtime, per-host)
.claude/scheduled_tasks.lock

# Stuck-guard post-mortems (runtime, may contain user-supplied tool args)
config/shared/stuck-tasks/

# browser_use pack — per-identity Chromium profiles. Treat as secrets.
# Cookies, IndexedDB, and local storage live here; never check in, never
# back up unencrypted.
config/browser_profiles/

# browser_use pack — age-encrypted secrets bundle. The blobs themselves
# are safe to back up (they're encrypted) but we still gitignore the dir
# so the README's example pubkey doesn't accidentally leak alongside any
# unencrypted .env files the operator forgot to shred.
config/secrets/browser/

# Compose's native escape hatch for local-only tweaks. The renderer
# (scripts/render_compose.py) never touches this file; each developer's
# overrides stay on their host.
docker-compose.override.yml

