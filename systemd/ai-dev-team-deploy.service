[Unit]
Description=ai-dev-team pull-based deploy
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=__DEPLOY_USER__
WorkingDirectory=__REPO_DIR__
Environment="REPO_DIR=__REPO_DIR__" "BRANCH=__BRANCH__"
ExecStart=__REPO_DIR__/scripts/deploy-pull.sh
StandardOutput=journal
StandardError=journal
