# Authentication for Claude Code CLI
#
# Select the auth method with CLAUDE_AUTH_MODE (defaults to "credentials" if unset):
#
#   CLAUDE_AUTH_MODE=credentials  (default)
#     On-disk .credentials.json from interactive Max login.
#     One-time setup: docker exec -it lisa claude auth login --claudeai
#     Credentials persist in the <agent>-claude-config Docker volume.
#
#   CLAUDE_AUTH_MODE=oauth_token
#     Long-lived OAuth token minted by `claude setup-token` on the operator's
#     machine.  Bills against the Max subscription quota (not metered API credits).
#     Generate: claude setup-token   →  copy the printed token below.
#     CLAUDE_CODE_OAUTH_TOKEN=<token from `claude setup-token`>
#
#   CLAUDE_AUTH_MODE=api_key
#     Metered API key.  Bills against API credits.
#     ANTHROPIC_API_KEY=sk-ant-api03-...
#
# All three modes are mutually exclusive: the entrypoint exports only the selected
# mode's secret and actively unsets the others.  Missing the required secret →
# hard startup failure (loud error, no silent fallback).
#
# CLAUDE_AUTH_MODE=credentials
# CLAUDE_CODE_OAUTH_TOKEN=<token from `claude setup-token`>
# ANTHROPIC_API_KEY=sk-ant-api03-...

# Slack integration (required for router)
LISA_BOT_TOKEN=xoxb-...
LISA_APP_TOKEN=xapp-...
LISA_SIGNING_SECRET=...

# Worker outbound-post identities (optional).
# Set these here to have workers post status back to the originating thread —
# the env var wins over any secrets.json entry, so .env is the single source of
# truth and you never patch a token into a committed file. Leave unset to fall
# back to the secrets.json store (workers_bot_token / workers_discord_token).
#   WORKERS_BOT_TOKEN      — Slack workers bot (xoxb-...), posts worker status to Slack
#   WORKERS_DISCORD_TOKEN  — Discord workers bot, posts worker status to Discord threads
#                            (one shared bot with Send Messages + Send Messages in
#                            Threads — NOT the per-agent inbound bots below)
# WORKERS_BOT_TOKEN=xoxb-...
# WORKERS_DISCORD_TOKEN=...

# browser_use sidecar — host path to the age keyfile. Compose bind-mounts
# this to /run/secrets/age.key inside the container.
# Linux prod default works without setting this. macOS dev must override
# (Docker Desktop doesn't share /etc by default).
# AGE_KEYFILE=/etc/ai-dev-team/age.key
# AGE_KEYFILE=$HOME/.config/ai-dev-team/age.key   # macOS dev

# Discord integration (optional — see docs/chat-backends-architecture.md)
# Set DISCORD_ENABLED=true to activate the Discord gateway path.
# Create one bot application per agent at https://discord.com/developers/applications
# and enable the MESSAGE CONTENT privileged intent for each.
# DISCORD_ENABLED=true
# SAM_DISCORD_BOT_TOKEN=...
# LISA_DISCORD_BOT_TOKEN=...
# SAM_DISCORD_CHANNEL_ID=123456789012345678    # default channel for proactive posts
# LISA_DISCORD_CHANNEL_ID=123456789012345678

# Stuck-guard (router-level loop / runaway detection)
# Default mode is "dry-run" — guard logs trips and posts to Slack but
# does not stop the agent. Flip to "enforce" once thresholds are tuned.
# STUCK_GUARD_MODE=dry-run
# STUCK_GUARD_TURN_CAP=50
# STUCK_GUARD_LOOP_WINDOW=5
# STUCK_GUARD_LOOP_THRESHOLD=3
# STUCK_GUARD_ERROR_STREAK=3
# STUCK_GUARD_POST_MORTEM_DIR=/config/shared/stuck-tasks

# Worker @mention handoff (Option A carve-out — see #285, #290)
# Set to 1 to allow workers-bot @mentions to pass through the bot-message guard
# so the router wakes the named agent exactly once on the worker's completion post.
WORKER_MENTION_HANDOFF=1
