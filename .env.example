# Authentication for Claude Code CLI
# Option A: API key (portable, works everywhere)
#   ANTHROPIC_API_KEY=sk-ant-api03-...
# Option B: Max subscription (interactive, one-time setup per machine)
#   After `docker compose up`, run: docker exec -it lisa claude auth login --claudeai
#   Credentials persist in the lisa-claude-config Docker volume.

# Slack integration (required for router)
LISA_BOT_TOKEN=xoxb-...
LISA_APP_TOKEN=xapp-...
LISA_SIGNING_SECRET=...

# browser_use sidecar — host path to the age keyfile. Compose bind-mounts
# this to /run/secrets/age.key inside the container.
# Linux prod default works without setting this. macOS dev must override
# (Docker Desktop doesn't share /etc by default).
# AGE_KEYFILE=/etc/ai-dev-team/age.key
# AGE_KEYFILE=$HOME/.config/ai-dev-team/age.key   # macOS dev

# Stuck-guard (router-level loop / runaway detection)
# Default mode is "dry-run" — guard logs trips and posts to Slack but
# does not stop the agent. Flip to "enforce" once thresholds are tuned.
# STUCK_GUARD_MODE=dry-run
# STUCK_GUARD_TURN_CAP=50
# STUCK_GUARD_LOOP_WINDOW=5
# STUCK_GUARD_LOOP_THRESHOLD=3
# STUCK_GUARD_ERROR_STREAK=3
# STUCK_GUARD_POST_MORTEM_DIR=/config/shared/stuck-tasks

# Worker @mention handoff (Option A carve-out — see #285, #290)
# Set to 1 to allow workers-bot @mentions to pass through the bot-message guard
# so the router wakes the named agent exactly once on the worker's completion post.
WORKER_MENTION_HANDOFF=1
